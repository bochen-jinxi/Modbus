<Window x:Class="ChenboScada.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChenboScada"
        Title="尘博 SCADA 监控站 · Modbus RTU" Width="1240" Height="820"
        Background="#16191D" Foreground="#D6DAE0" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <local:LogColorConverter x:Key="LogColor"/>

        <SolidColorBrush x:Key="BgPanel" Color="#1E2329"/>
        <SolidColorBrush x:Key="BgDeep" Color="#12161B"/>
        <SolidColorBrush x:Key="Edge" Color="#343B45"/>
        <SolidColorBrush x:Key="TxtMain" Color="#D6DAE0"/>
        <SolidColorBrush x:Key="TxtSub" Color="#8A93A0"/>
        <SolidColorBrush x:Key="CBlue" Color="#0A6CFF"/>
        <SolidColorBrush x:Key="CBtn" Color="#2D3540"/>
        <SolidColorBrush x:Key="CBtnHot" Color="#3A4452"/>
        <SolidColorBrush x:Key="CAmber" Color="#8A6D1F"/>
        <SolidColorBrush x:Key="CTemp" Color="#FF6B5E"/>
        <SolidColorBrush x:Key="CHum" Color="#4FA8FF"/>
        <SolidColorBrush x:Key="COn" Color="#3DDC84"/>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PanelHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TxtSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TxtSub}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="BigVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#2A3038"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CBtn}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CBtnHot}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource CBtn}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CBtnHot}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource CAmber}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgDeep}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TxtSub}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtMain}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ 菜单栏 ═══ -->
        <Menu DockPanel.Dock="Top" Padding="6,2">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="扫描总线" Command="{Binding ScanCommand}"/>
                <MenuItem Header="清空日志" Command="{Binding ClearLogsCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══ 状态栏 ═══ -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" Height="28">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource COn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Sub}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatsText}" Style="{StaticResource Sub}" Foreground="#FFB300"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding FrameText}" Style="{StaticResource Sub}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ClockText}" Style="{StaticResource Sub}" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="215"/>
            </Grid.RowDefinitions>

            <!-- ═══ 工具栏 ═══ -->
            <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="8,6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="串口" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ComboBox x:Name="PortBox" Width="92" ItemsSource="{Binding Ports}"
                              SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding CanEditPort}"/>
                    <Button Content="刷新" Command="{Binding RefreshPortsCommand}"/>
                    <TextBlock Text="轮询从站(Hex)" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,2,0"/>
                    <TextBox Text="{Binding SlaveText, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Margin="4,0" Padding="6,4" Background="{StaticResource BgDeep}"
                             Foreground="{StaticResource TxtMain}" BorderBrush="{StaticResource Edge}"
                             IsEnabled="{Binding CanEditPort}" ToolTip="逗号分隔十六进制地址，如 01,02"/>
                    <Button Content="{Binding StartBtnText}" Command="{Binding ToggleCommand}"
                            Background="{StaticResource CBlue}" BorderBrush="{StaticResource CBlue}" FontWeight="Bold"/>
                    <Button Content="扫描总线" Command="{Binding ScanCommand}"
                            Background="{StaticResource CAmber}" BorderBrush="{StaticResource CAmber}"
                            ToolTip="逐地址01~F7探测在线从站（需先停止轮询）"/>
                    <CheckBox Content="原始字节" IsChecked="{Binding ShowRaw}"
                              ToolTip="打印每批原始字节及当时在等哪个从站"/>
                </StackPanel>
            </Border>

            <!-- ═══ 主区 ═══ -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：从站仪表 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="12,10,12,8">
                                <TextBlock Text="SLAVE  0x01" Style="{StaticResource PanelHead}"/>
                                <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4A5260"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S1Online}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource COn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DockPanel>
                            <Border Style="{StaticResource HLine}" Margin="12,0"/>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="温度 TEMP" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Row="1" Text="{Binding S1Temp}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BigVal}">
                                            <Setter Property="Foreground" Value="{StaticResource CTemp}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S1Alarm}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="湿度 HUM" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="{Binding S1Hum}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BigVal}">
                                            <Setter Property="Foreground" Value="{StaticResource CHum}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S1Alarm}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Style="{StaticResource HLine}" Margin="12,0"/>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Sub}">
                                    <Run Text="更新 "/><Run Text="{Binding S1Updated}" FontFamily="Consolas"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Style="{StaticResource Sub}" TextAlignment="Right">
                                    <Run Text="超时 "/><Run Text="{Binding S1Timeout}" FontFamily="Consolas" Foreground="#FF5252"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="12,10,12,8">
                                <TextBlock Text="SLAVE  0x02" Style="{StaticResource PanelHead}"/>
                                <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4A5260"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S2Online}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource COn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DockPanel>
                            <Border Style="{StaticResource HLine}" Margin="12,0"/>
                            <Grid Margin="12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="温度 TEMP" Style="{StaticResource Sub}"/>
                                <TextBlock Grid.Row="1" Text="{Binding S2Temp}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BigVal}">
                                            <Setter Property="Foreground" Value="{StaticResource CTemp}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S2Alarm}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="湿度 HUM" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="{Binding S2Hum}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BigVal}">
                                            <Setter Property="Foreground" Value="{StaticResource CHum}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding S2Alarm}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFB300"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Style="{StaticResource HLine}" Margin="12,0"/>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Sub}">
                                    <Run Text="更新 "/><Run Text="{Binding S2Updated}" FontFamily="Consolas"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Style="{StaticResource Sub}" TextAlignment="Right">
                                    <Run Text="超时 "/><Run Text="{Binding S2Timeout}" FontFamily="Consolas" Foreground="#FF5252"/>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="链路说明" Style="{StaticResource PanelHead}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" LineHeight="17"
                                Text="发送线程轮询从站→WaitOne(50ms)；接收事件持io锁读出→持gate锁入buf；检测线程每1.8ms查3.5字符静默→切帧→校验→Set唤醒。离线判断：3秒无数据灯灭。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右：实时趋势（每个从站一个波形图） -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                            <TextBlock Text="实时趋势 TREND" Style="{StaticResource PanelHead}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Sub}"
                                       Text="波形图个数 = 轮询从站个数，启动时自动重建"/>
                        </DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource HLine}" Margin="12,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Charts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel}" Margin="8">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelHead}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <CheckBox Content="温度" IsChecked="{Binding ShowTemp}"
                                                                  Foreground="{StaticResource CTemp}"/>
                                                        <CheckBox Content="湿度" IsChecked="{Binding ShowHum}"
                                                                  Foreground="{StaticResource CHum}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border DockPanel.Dock="Top" Style="{StaticResource HLine}" Margin="12,0"/>
                                                <ContentControl Content="{Binding Wave}" Height="240" Margin="4"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═══ 通信日志 ═══ -->
            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                        <TextBlock Text="通信日志 LOG" Style="{StaticResource PanelHead}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Content="暂停" IsChecked="{Binding LogPaused}" Padding="10,2" Margin="4,0"/>
                            <Button Content="清空" Command="{Binding ClearLogsCommand}" Padding="10,2" Margin="4,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource HLine}" Margin="12,0"/>
                    <ListBox x:Name="LogBox" ItemsSource="{Binding Logs}" Background="{StaticResource BgDeep}"
                             BorderThickness="0" Margin="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{Binding Converter={StaticResource LogColor}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
