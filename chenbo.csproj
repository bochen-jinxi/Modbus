<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="5.0.2" />
    <PackageReference Include="System.IO.Ports" Version="5.0.0" />
  </ItemGroup>

  <!-- Scada 是独立的 WPF 子项目（有自己的 Scada.csproj），不能被本控制台项目重复编译 -->
  <!-- SlaveSim 是独立的从站模拟器子项目，同样排除 -->
  <ItemGroup>
    <Compile Remove="Scada\**" />
    <None Remove="Scada\**" />
    <Page Remove="Scada\**" />
    <EmbeddedResource Remove="Scada\**" />
    <Compile Remove="SlaveSim\**" />
    <None Remove="SlaveSim\**" />
    <EmbeddedResource Remove="SlaveSim\**" />
    <!-- Temperature3DAlarm 是独立的 WPF 子项目，排除 -->
    <Compile Remove="Temperature3DAlarm\**" />
    <None Remove="Temperature3DAlarm\**" />
    <Page Remove="Temperature3DAlarm\**" />
    <EmbeddedResource Remove="Temperature3DAlarm\**" />
  </ItemGroup>

</Project>
