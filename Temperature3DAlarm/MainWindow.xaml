<Window x:Class="Temperature3DAlarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:Temperature3DAlarm"
        Title="实时温度 3D 监测与报警 (HelixToolkit)" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部状态栏 -->
        <Border DockPanel.Dock="Top" Background="#222" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前温度：" Foreground="#CCC" FontSize="16"/>
                    <TextBlock x:Name="TempText" Foreground="White" FontSize="22" FontWeight="Bold" Margin="6,0,0,0"/>
                    <TextBlock Text="阈值：60°C" Foreground="#888" FontSize="14" Margin="20,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="StatusDot" Color="Green"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="StatusTextBlock" Foreground="#CCC" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 报警横幅 -->
        <Border x:Name="AlarmBanner" DockPanel.Dock="Top" Background="#E52222" Padding="12,6" Visibility="Collapsed">
            <TextBlock Text="⚠ 温度报警：超过 60°C 阈值，3D 模型已变红" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <!-- 左侧：3D 视图（子元素在代码后置中添加） -->
        <h:HelixViewport3D x:Name="Viewport"  Background="#0E1A2B" ShowCoordinateSystem="True"
                          CoordinateSystemWidth="60" CoordinateSystemHeight="60"
                          CameraRotationMode="Trackball"
                          ZoomExtentsWhenLoaded="True" Margin="0">
            <h:HelixViewport3D.DefaultCamera>
                <PerspectiveCamera Position="10,10,12" LookDirection="-10,-10,-12" UpDirection="0,0,1" FieldOfView="45"/>
            </h:HelixViewport3D.DefaultCamera>

            <h:DefaultLights/>

            <!-- 地面网格 -->
            <h:GridLinesVisual3D Width="16" Length="16" MajorDistance="2" MinorDistance="0.5"
                                 Thickness="1" Fill="#334455"/>
        </h:HelixViewport3D>

        <!-- 右侧：节点列表 -->
        <Border DockPanel.Dock="Right" Width="280" Background="#1A1A1A" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="传感器节点" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="SensorList"/>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
